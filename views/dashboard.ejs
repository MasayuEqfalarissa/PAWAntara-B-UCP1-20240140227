<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Admin - Toko Ariesta</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-stone-100/70 text-gray-800 flex flex-col min-h-screen font-sans">

  <%- include('partials/navbar') %>

  <main class="max-w-7xl mx-auto px-4 py-8 flex-grow w-full">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Dashboard Manajemen Produk</h1>
        <p class="text-xs text-gray-500">Halo <%= user.username %>, kelola stok dan harga sembako di sini.</p>
      </div>
      <button id="btn-logout" class="bg-red-500 text-white font-bold px-4 py-2 rounded-xl text-xs hover:bg-red-600 transition">
        Logout
      </button>
    </div>

    <!-- Form Tambah / Edit Produk -->
    <section class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm mb-8">
      <h2 id="form-title" class="text-lg font-bold text-gray-800 mb-4">Tambah Produk Baru</h2>
      
      <form id="form-product" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <input type="hidden" id="product-id">

        <div>
          <label for="name" class="block text-xs font-bold text-gray-700 mb-1">Nama Produk</label>
          <input type="text" id="name" class="w-full border border-gray-200 p-2.5 rounded-xl text-sm" placeholder="Contoh: Garam Dapur 250g">
        </div>

        <div>
          <label for="category" class="block text-xs font-bold text-gray-700 mb-1">Kategori</label>
          <select id="category" class="w-full border border-gray-200 p-2.5 rounded-xl text-sm">
            <option value="Beras & Tepung">Beras & Tepung</option>
            <option value="Minyak Goreng">Minyak Goreng</option>
            <option value="Gula & Garam">Gula & Garam</option>
            <option value="Telur & Susu">Telur & Susu</option>
            <option value="Minuman">Minuman</option>
          </select>
        </div>

        <div>
          <label for="price" class="block text-xs font-bold text-gray-700 mb-1">Harga (Rp)</label>
          <input type="number" id="price" class="w-full border border-gray-200 p-2.5 rounded-xl text-sm" placeholder="15000">
        </div>

        <div>
          <label for="stock" class="block text-xs font-bold text-gray-700 mb-1">Stok (pcs)</label>
          <input type="number" id="stock" class="w-full border border-gray-200 p-2.5 rounded-xl text-sm" placeholder="50">
        </div>

        <div class="md:col-span-2">
          <label for="image" class="block text-xs font-bold text-gray-700 mb-1">URL / Path Gambar</label>
          <input type="text" id="image" class="w-full border border-gray-200 p-2.5 rounded-xl text-sm" placeholder="/images/minyak.jpg atau URL online">
        </div>

        <div class="md:col-span-2 flex gap-2">
          <button type="submit" id="btn-submit" class="bg-emerald-600 text-white font-bold px-6 py-2.5 rounded-xl text-sm hover:bg-emerald-700 transition">
            Simpan Produk
          </button>
          <button type="button" id="btn-cancel" class="hidden bg-gray-200 text-gray-700 font-bold px-4 py-2.5 rounded-xl text-sm">
            Batal Edit
          </button>
        </div>
      </form>
    </section>

    <!-- Tabel Produk -->
    <section class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-x-auto">
      <table class="w-full text-left text-xs text-gray-700">
        <thead class="bg-stone-50 border-b border-gray-100 text-gray-500 uppercase">
          <tr>
            <th class="p-4">ID</th>
            <th class="p-4">Produk</th>
            <th class="p-4">Kategori</th>
            <th class="p-4">Harga</th>
            <th class="p-4">Stok</th>
            <th class="p-4 text-center">Aksi</th>
          </tr>
        </thead>
        <tbody id="table-products" class="divide-y divide-gray-100">
          <!-- Diisi via Fetch API -->
        </tbody>
      </table>
    </section>
  </main>

  <script>
    const tableBody = document.getElementById('table-products');
    const form = document.getElementById('form-product');

    // Fetch & Tampilkan Semua Produk
    async function loadProducts() {
      const res = await fetch('/api/products');
      const data = await res.json();
      tableBody.innerHTML = '';

      data.data.forEach(p => {
        tableBody.innerHTML += `
          <tr class="hover:bg-stone-50">
            <td class="p-4 font-bold">#${p.id}</td>
            <td class="p-4 flex items-center gap-3">
              <img src="${p.image}" class="w-10 h-10 object-cover rounded-lg">
              <span class="font-bold text-gray-800">${p.name}</span>
            </td>
            <td class="p-4">${p.category}</td>
            <td class="p-4 font-bold text-emerald-600">Rp ${p.price.toLocaleString('id-ID')}</td>
            <td class="p-4">${p.stock} pcs</td>
            <td class="p-4 text-center space-x-2">
              <button onclick="editProduct(${p.id}, '${p.name}', '${p.category}', ${p.price}, ${p.stock}, '${p.image}')" class="bg-amber-500 text-white font-bold px-3 py-1 rounded-lg">Edit</button>
              <button onclick="deleteProduct(${p.id})" class="bg-red-500 text-white font-bold px-3 py-1 rounded-lg">Hapus</button>
            </td>
          </tr>
        `;
      });
    }

    // Submit Form (Tambah / Update via Fetch)
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = document.getElementById('product-id').value;
      const name = document.getElementById('name').value.trim();
      const category = document.getElementById('category').value;
      const price = document.getElementById('price').value;
      const stock = document.getElementById('stock').value;
      const image = document.getElementById('image').value.trim();

      if (!name || !price || !stock) return alert('Mohon isi field utama!');

      const method = id ? 'PUT' : 'POST';
      const url = id ? `/api/products/${id}` : '/api/products';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, category, price, stock, image })
      });

      if (res.ok) {
        resetForm();
        loadProducts();
      } else {
        alert('Gagal menyimpan data.');
      }
    });

    // Edit & Delete Handlers
    function editProduct(id, name, category, price, stock, image) {
      document.getElementById('product-id').value = id;
      document.getElementById('name').value = name;
      document.getElementById('category').value = category;
      document.getElementById('price').value = price;
      document.getElementById('stock').value = stock;
      document.getElementById('image').value = image;
      document.getElementById('form-title').textContent = 'Edit Produk #' + id;
      document.getElementById('btn-cancel').classList.remove('hidden');
    }

    async function deleteProduct(id) {
      if (!confirm('Yakin ingin menghapus produk ini?')) return;
      const res = await fetch(`/api/products/${id}`, { method: 'DELETE' });
      if (res.ok) loadProducts();
    }

    function resetForm() {
      document.getElementById('product-id').value = '';
      form.reset();
      document.getElementById('form-title').textContent = 'Tambah Produk Baru';
      document.getElementById('btn-cancel').classList.add('hidden');
    }

    document.getElementById('btn-cancel').addEventListener('click', resetForm);

    // Logout
    document.getElementById('btn-logout').addEventListener('click', async () => {
      await fetch('/api/logout', { method: 'POST' });
      window.location.href = '/login';
    });

    loadProducts();
  </script>

  <%- include('partials/footer') %>

</body>
</html>