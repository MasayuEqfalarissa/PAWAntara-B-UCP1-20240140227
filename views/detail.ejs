<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail Produk - Toko Ariesta</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-stone-100/70 text-gray-800 flex flex-col min-h-screen font-sans">

  <%- include('partials/navbar') %>

  <main class="max-w-4xl mx-auto px-4 py-12 flex-grow w-full">
    <% if (!product) { %>
      <section class="bg-white border border-gray-100 p-8 rounded-2xl shadow-sm text-center">
        <p class="text-4xl mb-3">⚠️</p>
        <h1 class="text-xl font-bold mb-2 text-gray-800">Produk Tidak Ditemukan</h1>
        <p class="text-xs text-gray-500 mb-6">Maaf, produk yang kamu cari tidak ada di katalog kami.</p>
        <a href="/produk" class="inline-block bg-emerald-600 text-white font-bold px-5 py-2.5 rounded-xl hover:bg-emerald-700 transition text-xs">Kembali ke Katalog</a>
      </section>
    <% } else { %>
      <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden grid grid-cols-1 md:grid-cols-2">
        <div class="h-64 md:h-full bg-gray-200">
          <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover">
        </div>
        <div class="p-8 flex flex-col justify-between">
          <div>
            <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-3 py-1 rounded-full"><%= product.category %></span>
            <h1 class="text-2xl font-bold text-gray-900 mt-4"><%= product.name %></h1>
            <p class="text-2xl font-black text-emerald-600 my-3">Rp <%= product.price.toLocaleString('id-ID') %></p>
            <p class="text-sm text-gray-600 leading-relaxed mb-6"><%= product.description %></p>
          </div>

          <div class="border-t border-gray-100 pt-4 flex justify-between items-center text-xs">
            <span class="text-gray-500">Ketersediaan: <strong class="text-gray-800"><%= product.stock %> pcs</strong></span>
            <a href="/produk" class="bg-stone-100 text-gray-700 font-bold px-4 py-2 rounded-xl hover:bg-stone-200 transition">← Kembali</a>
          </div>
        </div>
      </article>
    <% } %>
  </main>

  <%- include('partials/footer') %>

</body>
</html>