<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Toko Ariesta - Katalog Produk Sembako</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-stone-100/70 text-gray-800 flex flex-col min-h-screen font-sans">

  <!-- Include Navbar -->
  <%- include('partials/navbar') %>

  <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Section Kategori Produk (Gaya Card Kotak Eksklusif) -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-center text-gray-900 mb-6 tracking-tight">Kategori Produk</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-4">
        
        <a href="/produk?kategori=Beras" class="bg-white p-4 rounded-2xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center border border-gray-100 group">
          <span class="text-2xl mb-2 group-hover:scale-110 transition">🌾</span>
          <span class="text-xs font-bold text-gray-800">Beras & Tepung</span>
        </a>

        <a href="/produk?kategori=Minyak" class="bg-white p-4 rounded-2xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center border border-gray-100 group">
          <span class="text-2xl mb-2 group-hover:scale-110 transition">🛢️</span>
          <span class="text-xs font-bold text-gray-800">Minyak Goreng</span>
        </a>

        <a href="/produk?kategori=Gula" class="bg-white p-4 rounded-2xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center border border-gray-100 group">
          <span class="text-2xl mb-2 group-hover:scale-110 transition">🧂</span>
          <span class="text-xs font-bold text-gray-800">Gula & Garam</span>
        </a>

        <a href="/produk?kategori=Telur" class="bg-white p-4 rounded-2xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center border border-gray-100 group">
          <span class="text-2xl mb-2 group-hover:scale-110 transition">🥚</span>
          <span class="text-xs font-bold text-gray-800">Telur & Susu</span>
        </a>

        <a href="/produk" class="bg-white p-4 rounded-2xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center border border-gray-100 group">
          <span class="text-2xl mb-2 group-hover:scale-110 transition">🍜</span>
          <span class="text-xs font-bold text-gray-800">Mie & Pasta</span>
        </a>

        <a href="/produk" class="bg-white p-4 rounded-2xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center border border-gray-100 group">
          <span class="text-2xl mb-2 group-hover:scale-110 transition">🌶️</span>
          <span class="text-xs font-bold text-gray-800">Bumbu Dapur</span>
        </a>

        <a href="/produk?kategori=Minuman" class="bg-white p-4 rounded-2xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center border border-gray-100 group">
          <span class="text-2xl mb-2 group-hover:scale-110 transition">🧃</span>
          <span class="text-xs font-bold text-gray-800">Minuman</span>
        </a>

      </div>
    </section>

    <!-- Section Produk Terbaru -->
    <section>
      <h2 class="text-2xl font-bold text-center text-gray-900 mb-6 tracking-tight">Produk Terbaru</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        <% featuredProducts.forEach(product => { %>
          <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden flex flex-col justify-between hover:shadow-md transition group">
            <a href="/produk/<%= product.id %>" class="block">
              <!-- Gambar Produk -->
              <div class="w-full h-48 bg-gray-200 overflow-hidden">
                <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
              </div>
              
              <!-- Info Produk -->
              <div class="p-4">
                <h3 class="text-base font-bold text-gray-900 group-hover:text-emerald-600 transition line-clamp-1"><%= product.name %></h3>
                <p class="text-sm font-semibold text-gray-700 mt-1">Rp <%= product.price.toLocaleString('id-ID') %></p>
                <p class="text-xs text-gray-500 mt-1">Stok: <%= product.stock %> pcs</p>
              </div>
            </a>
          </article>
        <% }) %>
      </div>
    </section>

  </main>

  <!-- Include Footer -->
  <%- include('partials/footer') %>

</body>
</html>