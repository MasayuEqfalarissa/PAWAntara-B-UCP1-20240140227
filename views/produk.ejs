<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daftar Produk - Toko Ariesta</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-stone-100/70 text-gray-800 flex flex-col min-h-screen font-sans">

  <%- include('partials/navbar') %>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Katalog Produk Sembako</h1>

    <!-- Filter & Search Bar -->
    <section class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mb-8">
      <form action="/produk" method="GET" class="flex flex-col md:flex-row gap-3">
        <div class="flex-grow">
          <label for="search" class="sr-only">Cari Produk</label>
          <input type="text" id="search" name="search" value="<%= currentSearch %>" placeholder="Cari nama produk..." class="border border-gray-200 p-2.5 rounded-xl w-full focus:outline-emerald-500 text-sm">
        </div>
        
        <div>
          <label for="kategori" class="sr-only">Kategori</label>
          <select id="kategori" name="kategori" class="border border-gray-200 p-2.5 rounded-xl w-full focus:outline-emerald-500 text-sm text-gray-700">
            <option value="">Semua Kategori</option>
            <option value="Beras" <%= currentKategori === 'Beras' ? 'selected' : '' %>>Beras & Tepung</option>
            <option value="Minyak" <%= currentKategori === 'Minyak' ? 'selected' : '' %>>Minyak Goreng</option>
            <option value="Gula" <%= currentKategori === 'Gula' ? 'selected' : '' %>>Gula & Garam</option>
            <option value="Telur" <%= currentKategori === 'Telur' ? 'selected' : '' %>>Telur & Susu</option>
            <option value="Minuman" <%= currentKategori === 'Minuman' ? 'selected' : '' %>>Minuman</option>
          </select>
        </div>

        <button type="submit" class="bg-emerald-600 text-white px-6 py-2.5 rounded-xl font-bold text-sm hover:bg-emerald-700 transition shadow-sm">Cari</button>
      </form>
    </section>

    <!-- Grid Katalog Produk -->
    <section class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
      <% if (products.length === 0) { %>
        <div class="col-span-full text-center py-12 bg-white rounded-2xl border border-gray-100 p-6">
          <p class="text-gray-400 text-3xl mb-2">🔍</p>
          <p class="text-gray-500 text-sm">Produk yang kamu cari tidak ditemukan.</p>
        </div>
      <% } else { %>
        <% products.forEach(product => { %>
          <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden flex flex-col justify-between hover:shadow-md transition group">
            <a href="/produk/<%= product.id %>" class="block">
              <div class="w-full h-48 bg-gray-200 overflow-hidden">
                <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
              </div>
              <div class="p-4">
                <span class="text-[10px] bg-emerald-50 text-emerald-700 font-bold px-2 py-0.5 rounded-md"><%= product.category %></span>
                <h2 class="text-base font-bold text-gray-900 group-hover:text-emerald-600 transition mt-2 line-clamp-1"><%= product.name %></h2>
                <p class="text-sm font-semibold text-gray-700 mt-1">Rp <%= product.price.toLocaleString('id-ID') %></p>
                <p class="text-xs text-gray-500 mt-1">Stok: <%= product.stock %> pcs</p>
              </div>
            </a>
          </article>
        <% }) %>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>

</body>
</html>